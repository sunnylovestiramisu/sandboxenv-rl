{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-on-gke.github.io/sandboxenv-rl/schema/v1/report.schema.json",
  "title": "Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "scenario_name", "generated_at", "validity"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["v1"] },
    "run_id": { "type": "string", "minLength": 1 },
    "scenario_name": { "type": "string", "minLength": 1 },
    "tag": { "type": "string" },
    "generated_at": { "type": "string", "minLength": 1 },
    "system_description": { "$ref": "system_description.schema.json" },
    "measurements_ref": { "type": "string" },
    "measurements": { "type": "object" },
    "validity": { "$ref": "#/$defs/ReportValidity" },
    "fault_classification": { "$ref": "#/$defs/FaultClassification" },
    "jobs": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/JobReportSummary" }
    },
    "custom_metrics": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/MetricSummary" }
    }
  },
  "$defs": {
    "ReportValidity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid"],
      "properties": {
        "valid": { "type": "boolean" },
        "reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "FaultCategorySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "category", "dropped", "recovered", "events"],
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["tier1_before_episode", "tier2_policy", "tier3_during_episode"]
        },
        "category": {
          "type": "string",
          "enum": [
            "create_timeout",
            "no_capacity",
            "image_pull_unpack",
            "transport_error",
            "nonzero_exit",
            "command_timeout",
            "guest_oom",
            "wake_resume_failure",
            "sandbox_crash",
            "snapshot_restore_failure",
            "eviction_preemption",
            "other"
          ]
        },
        "dropped": { "type": "integer", "minimum": 0 },
        "recovered": { "type": "integer", "minimum": 0 },
        "events": { "type": "integer", "minimum": 0 },
        "example_err": { "type": "string" }
      }
    },
    "FaultClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_rollouts",
        "infra_dropped",
        "tier1_dropped",
        "tier2_policy",
        "tier3_dropped",
        "recovered_retries",
        "infra_fault_rate",
        "target_rate",
        "meets_target"
      ],
      "properties": {
        "all_rollouts": { "type": "integer", "minimum": 0 },
        "infra_dropped": { "type": "integer", "minimum": 0 },
        "tier1_dropped": { "type": "integer", "minimum": 0 },
        "tier2_policy": { "type": "integer", "minimum": 0 },
        "tier3_dropped": { "type": "integer", "minimum": 0 },
        "recovered_retries": { "type": "integer", "minimum": 0 },
        "post_rollout_errors": { "type": "integer", "minimum": 0 },
        "infra_fault_rate": { "type": "number", "minimum": 0 },
        "target_rate": { "type": "number", "exclusiveMinimum": 0 },
        "meets_target": { "type": "boolean" },
        "categories": {
          "type": "array",
          "items": { "$ref": "#/$defs/FaultCategorySummary" }
        }
      }
    },
    "JobReportSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks", "failed", "rewarded", "reward_rate"],
      "properties": {
        "tasks": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "rewarded": { "type": "integer", "minimum": 0 },
        "reward_rate": { "type": "number", "minimum": 0 },
        "steps": { "type": "integer", "minimum": 0 },
        "fault_classification": { "$ref": "#/$defs/FaultClassification" },
        "metrics": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/MetricSummary" }
        }
      }
    },
    "MetricSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "sum": { "type": "number" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "p50": { "type": "number" },
        "p90": { "type": "number" },
        "p95": { "type": "number" },
        "p99": { "type": "number" },
        "unit": { "type": "string" }
      }
    }
  }
}
